# Environment Configuration Template
# Copy this file to .env and adjust values as needed

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seismic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# NATS Configuration
NATS_HOST=localhost
NATS_PORT=4222
NATS_MONITORING_PORT=8222

# EMSC WebSocket Configuration
SEISMIC_WEBSOCKET_URL=wss://www.seismicportal.eu/standing_order/websocket

# wasmCloud Configuration
WASMCLOUD_RPC_HOST=0.0.0.0
WASMCLOUD_RPC_PORT=4222
WASMCLOUD_CTL_HOST=127.0.0.1
WASMCLOUD_CTL_PORT=4222

# Application Configuration
LOG_LEVEL=info
BUCKET_NAME=seismic-events
